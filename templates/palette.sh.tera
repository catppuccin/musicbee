---
whiskers:
  version: "^2.9.0"
  filename: ".build/palette.sh"
---
# Generated by Whiskers. Do not edit.

theme_names=({% for identifier, _ in flavors %}"{{ identifier }}" {% endfor %})
palette_names=({% for identifier, color in flavors.latte.colors %}{% if color.accent %}"{{ identifier }}" {% endif %}{% endfor %})

{% for identifier, flavor in flavors %}
{{ identifier }}_accents_hex=({% for _, color in flavor.colors %}{% if color.accent %}"{{ color.hex }}" {% endif %}{% endfor %})
{% endfor %}

crusts_hex=({% for _, flavor in flavors %}"{{ flavor.colors.crust.hex }}" {% endfor %})
crusts_svgs_hex=({% for _, flavor in flavors %}"{% if flavor.light %}{{ flavor.colors.text.hex }}{% else %}{{ flavor.colors.crust.hex }}{% endif %}" {% endfor %})
mantles_hex=({% for _, flavor in flavors %}"{{ flavor.colors.mantle.hex }}" {% endfor %})
texts_hex=({% for _, flavor in flavors %}"{{ flavor.colors.text.hex }}" {% endfor %})
subtext0s_hex=({% for _, flavor in flavors %}"{{ flavor.colors.subtext0.hex }}" {% endfor %})
overlay0s_hex=({% for _, flavor in flavors %}"{{ flavor.colors.overlay0.hex }}" {% endfor %})
surface0s_hex=({% for _, flavor in flavors %}"{{ flavor.colors.surface0.hex }}" {% endfor %})
surface1s_hex=({% for _, flavor in flavors %}"{{ flavor.colors.surface1.hex }}" {% endfor %})
reds_hex=({% for _, flavor in flavors %}"{{ flavor.colors.red.hex }}" {% endfor %})
